# Configurazione pubblica dell’app Web Firebase, dalla console del progetto.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Dopo esserti registrato, copia qui il tuo nuovo UID da Firebase Authentication.
# Vuoto: nessuno accede alla raccolta precedente. Non inserire nome o email.
BOOKFLIX_OWNER_UID=
